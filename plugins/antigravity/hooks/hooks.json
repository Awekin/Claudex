{
  "description": "Exports the Claude session's transcript path and data folder for the Antigravity companion.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
